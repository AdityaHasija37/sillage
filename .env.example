# Copy to .env.local. Values for local dev come from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_ and never log it.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only. Salt for hashing client IPs in rate limits.
RATE_SALT=
# Optional. Powers the AI advisor and Today's explanation. Set either key (or both).
# Without any key the advisor runs in deterministic offline mode.
# Free option: a Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.8-flash (free tier).
GEMINI_MODEL=
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
ADVISOR_MODEL=
# Optional. "gemini" or "anthropic" when both keys are set (default: anthropic if its key is set).
ADVISOR_PROVIDER=
# Optional. Live Google Shopping offers via SerpApi (free tier: 250 searches/month).
# Without it, offers are clearly labelled sample data.
SERPAPI_API_KEY=
# Optional. "false" hides the one-click demo sandbox.
DEMO_ENABLED=
# Optional. Demo sandboxes per visitor per hour (default 5). Raise only for local E2E runs.
DEMO_HOURLY_LIMIT=
